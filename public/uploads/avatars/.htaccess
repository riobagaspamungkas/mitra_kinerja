# Protect uploads directory from script execution
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|asp|sh|shtml|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
