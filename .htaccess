# Blokir akses langsung ke berkas sensitif (.bat, .sh, .env, .sql, .md, .gitignore)
<FilesMatch "(?i:\.(bat|sh|env|sql|md)$|^\.gitignore$|^\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir akses ke direktori .git secara menyeluruh di Apache
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
</IfModule>

# Blokir berkas tersembunyi berawalan titik
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
