# Environment & Local Overrides
.env
.env.*
config/*.local.php
!config/*.local.php.example

# Runtime Caches & Dynamic Data
cache/*.json
cache/sessions/*
!cache/.htaccess
!cache/sessions/.gitkeep
public/uploads/avatars/*
!public/uploads/avatars/.gitkeep
!public/uploads/avatars/.htaccess
*.log

# Backups & Temporary Files
backups/*
!backups/.htaccess
*.tmp
*.bak
Thumbs.db
.DS_Store
__pycache__/
*.pyc

# Virtual Environments & Package Managers
.venv/
venv/
vendor/

# Large Documentation Archives & Media Files
docs/*
!docs/.htaccess
!docs/CHANGELOG.txt
!docs/*.md
